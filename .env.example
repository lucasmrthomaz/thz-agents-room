# =============================================================================
# THZ Minds — Configuracao
# Copie para .env e ajuste conforme necessidade
# =============================================================================

# --- Server ---
PORT=9983
HOST=0.0.0.0
WORKERS=1

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# No Docker Compose, use: http://ollama:11434

# --- Modelos ---
DEFAULT_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Debate ---
CONSENSUS_THRESHOLD=5
LANGUAGE=pt-BR

# --- Paths (relativos ao WORKDIR) ---
DB_PATH=data/thz-room-cortex.db
DATA_DIR=data
SESSIONS_DIR=sessions
OUTPUT_DIR=output
